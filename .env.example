# ─── Base de données ──────────────────────────────────────────────────────────
DB_USER=cybervuln
DB_PASSWORD=changeme_password_fort
DB_NAME=cybervuln
# Sessions HTTP simultanées max (10/08/2026, cf. AUDIT_SECURITE.md) — sémaphore appliqué
# aux 162 routes de l'API (database.py::get_session), pas un pool de connexions (NullPool
# conservé, nécessaire pour Celery). Défaut 5, à ajuster si trop restreint en usage réel.
DB_MAX_CONCURRENT_SESSIONS=5

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Claude API ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── NVD / NIST (gratuit sur https://nvd.nist.gov/developers/request-an-api-key)
# Sans clé : 5 req/30s — Avec clé : 50 req/30s (recommandé)
NVD_API_KEY=

# ─── GitHub (recherche de code, Surveillance Identités — services/leak_lookup.py)
# Token personnel classique, gratuit, AUCUN scope à cocher (lecture publique
# seulement) : https://github.com/settings/tokens -> "Generate new token (classic)"
# Sans lui, la vérification GitHub des identités "domaine" est simplement désactivée
# (pas une erreur) — XposedOrNot (identités "email") reste actif sans clé.
GITHUB_TOKEN=

# ─── Active Directory ─────────────────────────────────────────────────────────
# Créer un compte de service dédié en lecture seule dans l'AD
AD_SERVER=ldap://dc01.domaine.local
AD_USER=CN=svc-cybervuln,OU=ServiceAccounts,DC=domaine,DC=local
AD_PASSWORD=changeme
AD_BASE_DN=DC=domaine,DC=local
# Optionnel : limiter à une OU spécifique (ex: serveurs uniquement)
AD_OU=OU=Servers,DC=domaine,DC=local
# false (défaut) = StartTLS sur le ldap:// ci-dessus (port 389, chiffré, aucun changement d'URL) ;
# true = ldaps:// implicite (port 636) — seulement si le contrôleur de domaine l'expose
AD_USE_TLS=false

# ─── SSH Linux ────────────────────────────────────────────────────────────────
# Compte dédié sans droits sudo, clé SSH sans passphrase
SSH_USER=svc-cybervuln
SSH_KEY_PATH=/app/keys/id_ed25519
# TOFU : clé hôte apprise et pinnée au premier contact. Laisser vide = /app/keys/known_hosts
SSH_KNOWN_HOSTS=

# IPs ou hostnames de vos VM Linux, séparés par virgule
LINUX_HOSTS=10.0.1.50,10.0.1.51,10.0.1.52

# ─── WithSecure Elements API (lecture seule) ──────────────────────────────────
# Client OAuth2 créé dans Security Center > Gestion > Paramètres de la société >
# Clients API. Cocher "Read-only" à la création. Complète l'EDR/EPP déjà déployé
# (events/incidents + correctifs manquants avec CVE/CVSS). Le module Vulnerability
# Management (ex-Radar) n'est pas souscrit — non utilisé ici.
WITHSECURE_API_CLIENT_ID=
WITHSECURE_API_CLIENT_SECRET=

# ─── Cisco Meraki Dashboard API (lecture seule) ───────────────────────────────
# Clé API personnelle (Meraki Dashboard > Profil > My profile > API access).
# Supervision réseau en ligne/hors ligne des actifs (cf. services/meraki_client.py).
# MERAKI_ORGANIZATION_ID optionnel : si absent, la première organisation visible
# par la clé est utilisée — à renseigner si la clé a accès à plusieurs organisations.
MERAKI_API_KEY=
MERAKI_ORGANIZATION_ID=

# ─── PRTG Network Monitor (lecture seule) ──────────────────────────────────────
# API cœur PRTG (pas Multiboard, qui sert à agréger des widgets visuels entre
# instances, pas à interroger le statut d'un device). URL de base du serveur PRTG
# (ex: https://prtg.exemple.local:8443, sans chemin) + token API (Setup > Account
# Settings > API Keys côté PRTG, ou passhash legacy).
PRTG_URL=
PRTG_API_TOKEN=
# false uniquement si le serveur PRTG présente un certificat signé par une CA interne
# (AD CS...) non approuvée par le conteneur — ne pas désactiver par défaut.
PRTG_VERIFY_TLS=true

# ─── GLPI (lecture seule, CMDB patrimoine) ─────────────────────────────────────
# URL de l'API REST GLPI (ex: https://glpi.exemple.local/apirest.php).
# GLPI_APP_TOKEN : client API dédié créé dans GLPI (Configuration > Générale > API
# > Clients API) — cocher "Enregistrer les connexions" sur "Journaux".
# GLPI_USER_TOKEN : jeton personnel d'un compte de service dédié (ex: svc-allsafe),
# rattaché à un profil lecture seule — jamais le compte admin GLPI.
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# ─── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=changeme_secret_fort
DEBUG=false
# Jeton partagé worker → backend (07/08/2026) — permet aux tâches Celery
# (patch_check_periodic, run_cpe_matching_for_asset_task) de déclencher
# POST /api/patch-check/run sans session utilisateur (cf. auth_deps.py::
# require_page_or_internal). Optionnel : absent = ces déclenchements échouent
# proprement (401, retry Celery) sans rien casser d'autre. Générer avec
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
INTERNAL_API_TOKEN=

# Tâches lancées au démarrage du backend (corrélation CVE, puis cycle de patch check).
# Laisser à true en production : un redémarrage doit rattraper ce qui a été manqué.
# Les passer à false permet de redémarrer le backend SANS effet de bord sur les
# données — utile en développement, où un rechargement de code crée sinon des
# vulnérabilités et bascule des statuts. Les deux restent déclenchables à la main :
# POST /api/sync/match  et  POST /api/patch-check/run
STARTUP_MATCHING=true
STARTUP_PATCH_CHECK=true

# ─── Sauvegarde PostgreSQL ────────────────────────────────────────────────────
# pg_dump quotidien (4h, cf. tasks/scheduled_tasks.py) vers le volume `backups`.
# Nombre de jours de rétention avant suppression automatique. Optionnel, défaut 14.
BACKUP_RETENTION_DAYS=14

# ─── Authentification ─────────────────────────────────────────────────────────
# Bootstrap du premier compte admin (une seule fois, idempotent — cf. main.py::lifespan).
# ⚠️ À retirer de .env après la première connexion (cf. CHECKLIST_DOCKER.md) : ce mot de
# passe reste en clair dans ce fichier tant qu'il y figure.
BOOTSTRAP_ADMIN_EMAIL=admin@exemple.local
BOOTSTRAP_ADMIN_PASSWORD=changeme_mdp_provisoire_fort

# Cookie de session HttpOnly `Secure` : nécessite HTTPS. false (défaut) tant qu'aucun
# reverse-proxy TLS n'est devant l'app (déploiement HTTP interne actuel) — à passer à
# true dès qu'un TLS est mis en place, sinon le navigateur rejette le cookie en HTTPS.
COOKIE_SECURE=false
