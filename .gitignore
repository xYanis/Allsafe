# Secrets réels — jamais committés. .env.example est le template versionné.
.env
.env.local
keys/id_ed25519
keys/id_ed25519.pub
keys/known_hosts
cookies.txt

# Python
__pycache__/
*.pyc
backend/venv/
backend/.venv/
*.egg-info/

# Runtime/cache locaux — jamais du code source, régénérés au démarrage/à l'usage
backend/celerybeat-schedule*
backend/cache/
backend/note_images/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Agent Rust
agent/target/
agent/dist/
agent/*.msi
agent/*.deb
agent/*.exe

# Caches de build locaux
.cargo-cache/

# Claude Code — fichiers locaux, non partagés
.claude/

# Rapports de scan sécurité — résultats de vulnérabilités, jamais publics
strix_runs/

# Éditeurs / OS
.DS_Store
*.swp
