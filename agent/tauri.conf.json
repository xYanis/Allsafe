{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Allsafe Agent",
  "identifier": "local.allsafe.agent",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Allsafe Agent",
        "width": 480,
        "height": 460,
        "resizable": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
