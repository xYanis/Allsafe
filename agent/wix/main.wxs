<?xml version="1.0" encoding="utf-8"?>
<!--
  Empaquetage MSI de l'agent Allsafe. Construit avec `wixl` (paquet Debian/Ubuntu
  `msitools`) plutôt que le WiX Toolset officiel (Windows uniquement, .NET Framework,
  candle.exe/light.exe) — `wixl` comprend un sous-ensemble de cette même syntaxe WXS
  suffisant pour un installeur mono-binaire sans UI custom, cf. agent/README.md § MSI.

  UpgradeCode figé une fois pour toutes (ne JAMAIS le régénérer) : c'est lui qui permet à
  Windows Installer de reconnaître une mise à jour de la même application plutôt que
  d'installer une deuxième copie en parallèle.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Allsafe Agent"
           Language="1033"
           Version="0.1.19.0"
           Manufacturer="Allsafe"
           UpgradeCode="F7307503-099E-4424-9611-81DE4739933C">

    <!-- 64-bit obligatoire (13/08/2026) : sans ça, wixl construit un paquet marqué 32-bit
         (Template "Intel;1033") et Windows Installer peut rediriger ProgramFiles64Folder
         vers "Program Files (x86)" selon le contexte d'exécution du moment — constaté en
         conditions réelles sur DEPLOYAPP, binaire installé au mauvais endroit sans erreur
         ni avertissement. Un attribut `Platform="x64"` ici serait le réflexe WiX officiel,
         mais cette version de wixl (msitools 0.101) ne le supporte pas (silently ignoré,
         warning GLib) — l'architecture se fixe uniquement en ligne de commande, cf.
         `wixl -a x64` dans agent/README.md § Build. -->
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"
             Description="Agent Allsafe (lecture seule) pour postes Windows"
             Manufacturer="Allsafe" />

    <Media Id="1" Cabinet="allsafe.cab" EmbedCab="yes" />

    <!-- Mise à jour majeure (19/08/2026, bug réel constaté — install::apply_update lance
         `msiexec /i` sur un .msi rebuild à chaque release avec un NOUVEAU ProductCode
         (Product Id="*" ci-dessus, volontaire) : sans cette table `Upgrade`, Windows
         Installer n'a aucun moyen de savoir que ce nouveau produit doit REMPLACER
         l'ancien — `msiexec` rend un succès (exit 0) sans que rien de significatif ne se
         passe (constaté sur `armadasenonches` : "succès" affiché côté agent, mais version
         inchangée en base après). `UpgradeCode` (fixe, jamais régénéré, cf. commentaire
         d'en-tête) identifie la FAMILLE de produits à travers tous les ProductCode ; la
         plage de versions couvre tout sauf la version en cours d'installation elle-même.
         `RemoveExistingProducts` dans la séquence déclenche la désinstallation de l'ancien
         produit détecté.

         ⚠️ **`After="InstallFinalize"` (pas `InstallValidate`), corrigé le même jour après un
         2e incident réel** : le composant `MainExecutable` ci-dessous garde un GUID FIXE
         entre les versions (délibéré, pour que le remplacement de fichier passe par le
         comptage de références MSI plutôt qu'une suppression/recréation) — un piège MSI
         documenté (Microsoft) veut qu'avec un composant PARTAGÉ ainsi entre l'ancien et le
         nouveau produit, programmer `RemoveExistingProducts` TÔT (comme la première version
         de ce correctif le faisait) retire l'ancien produit AVANT que le nouveau n'ait posé
         ses propres fichiers : le comptage de références du composant partagé tombe à zéro,
         ses fichiers sont supprimés, et rien ne les remet en place — reproduit en conditions
         réelles sur `armadasenonches` (mise à jour "réussie" mais `Program Files\Allsafe
         Agent` entièrement vide après coup, plus d'exe ni de dll). Programmé TARD à la place :
         le nouveau produit installe D'ABORD ses fichiers (le composant partagé passe à 2
         propriétaires), PUIS l'ancien produit se désinstalle (le compteur retombe à 1, les
         fichiers restent puisque le nouveau produit en a toujours besoin). C'est le
         comportement historique par défaut de Windows Installer, pas une exception — l'early
         scheduling n'est utile que si les DEUX versions ne doivent jamais coexister, même
         un court instant, ce qui n'est pas notre cas ici.

         `Maximum="99.0.0.0"` (pas la version courante) — délibéré : `wixl` ne supporte pas
         l'élément `<MajorUpgrade>` de WiX v3 (qui calculerait ce plafond dynamiquement depuis
         la version en cours de build), donc une valeur figée demanderait normalement d'être
         rebumpée à CHAQUE release pour continuer à couvrir "toute version antérieure" — un 4e
         endroit à ne pas oublier en plus de Cargo.toml/Cargo.lock/`Version` ci-dessus (déjà un
         piège connu une fois par le passé, cf. § Mise à jour de agent/README.md). Un plafond
         haut et fixe élimine ce risque : couvre toute version plausible du produit sans jamais
         avoir besoin d'y retoucher. -->
    <Upgrade Id="F7307503-099E-4424-9611-81DE4739933C">
      <UpgradeVersion Minimum="0.0.0.0" IncludeMinimum="yes"
                       Maximum="99.0.0.0" IncludeMaximum="no"
                       Property="OLDER_VERSION_FOUND" />
    </Upgrade>
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallFinalize" />
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Allsafe Agent">
          <Component Id="MainExecutable" Guid="44E7BDA5-2EED-496E-BF11-CB2F0D3BF578">
            <File Id="AllsafeAgentEXE" Name="allsafe-agent.exe" KeyPath="yes"
                  Source="target/x86_64-pc-windows-gnu/release/allsafe-agent.exe" />
            <!-- WebView2Loader.dll (18/08/2026, passage de la fenêtre graphique à Tauri,
                 cf. gui.rs) — obligatoire à côté de l'exe sur cette cible GNU (import
                 statique résolu par Windows avant même le lancement du programme, pas un
                 chargement à la demande qu'on pourrait éviter). Généré automatiquement par
                 `tauri-build` dans le même dossier que l'exe compilé — même `Source`, juste
                 le nom de fichier qui change. -->
            <File Id="WebView2LoaderDLL" Name="WebView2Loader.dll"
                  Source="target/x86_64-pc-windows-gnu/release/WebView2Loader.dll" />
            <!-- Service Windows (13/08/2026, mode recommandé — cf. deploy/README.md).
                 Name="AllsafeAgent" doit correspondre exactement à SERVICE_NAME dans
                 service.rs. Arguments="service-run" : sous-commande cachée dédiée au SCM
                 (clap dérive le nom en kebab-case depuis Commands::ServiceRun), jamais
                 `run` — celle-là reste le mode interactif/systemd Linux, incompatible
                 avec service_dispatcher::start (cf. commentaire d'en-tête service.rs).
                 CHECKPOINT DE VÉRIFICATION (cf. plan) : confirmer après build que wixl a
                 bien honoré ces éléments — `msiinfo export allsafe-agent.msi
                 ServiceInstall` ne doit pas être vide. -->
            <ServiceInstall Id="AllsafeAgentService" Type="ownProcess" Name="AllsafeAgent"
                             DisplayName="Allsafe Agent" Description="Agent Allsafe (lecture seule) — collecte + check-in périodique"
                             Start="auto" Account="LocalSystem" ErrorControl="normal"
                             Arguments="service-run" />
            <ServiceControl Id="AllsafeAgentServiceControl" Name="AllsafeAgent"
                             Start="install" Stop="both" Remove="uninstall" Wait="yes" />
            <!-- PATH système (17/08/2026) — sans ça, `allsafe-agent enroll` après un
                 `msiexec /qn` échoue en "terme non reconnu" tant qu'on ne retape pas le
                 chemin complet vers INSTALLFOLDER (constaté en conditions réelles, poste
                 aos12). Part="last" pour ne rien écraser d'existant. CHECKPOINT DE
                 VÉRIFICATION (comme ServiceInstall ci-dessus, wixl a déjà silencieusement
                 ignoré un attribut par le passé) : après build, `msiinfo export
                 allsafe-agent.msi Environment` ne doit pas être vide, puis vérifier après
                 install que `allsafe-agent` est bien résolu dans un nouveau terminal
                 (ouvrir un terminal APRÈS l'install — une session déjà ouverte ne relit
                 pas le PATH). -->
            <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no"
                         Part="last" Action="set" System="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="Allsafe Agent" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Product>
</Wix>
